<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <IsPublishable>true</IsPublishable>

    <Copyright>Copyright (c) h.tacayama 2025</Copyright>

    <Authors>h.tacayama</Authors>
    <Description>Generates C# table classes for SqlArtisan from a live MySQL, Oracle, PostgreSQL, SQLite or SQL Server database, so column names are compile-checked, and reports where the classes have drifted from the schema (--check, --fix).</Description>
    <PackageTags>database sql codegen scaffolding schema dotnet-tool mysql oracle postgresql sqlite sqlserver</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>

    <PackageProjectUrl>https://github.com/h-tacayama/SqlArtisan</PackageProjectUrl>
    <RepositoryUrl>https://github.com/h-tacayama/SqlArtisan</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <PackAsTool>True</PackAsTool>
    <ToolCommandName>sa-tableclassgen</ToolCommandName>
    <!-- A tool left at the default Minor policy does not start on a machine that
         has only a newer major runtime, such as one installed after .NET 8's end of support. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.8.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <!-- Direct reference lifts the transitive SQLitePCLRaw.lib.e_sqlite3 2.1.10
         pulled by Microsoft.Data.Sqlite above the NU1903 advisory GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- Direct reference lifts the transitive System.Security.Cryptography.Pkcs 8.0.1
         pulled by Oracle.ManagedDataAccess.Core and Microsoft.Data.SqlClient above the
         NU1903 advisory GHSA-846f-f764-76mx and the NU1902 advisory GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlArtisan.TableClassGen.Tests" />
    <InternalsVisibleTo Include="SqlArtisan.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlArtisan.Dapper\SqlArtisan.Dapper.csproj" />
    <ProjectReference Include="..\SqlArtisan\SqlArtisan.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\assets\icon.png" Link="icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>