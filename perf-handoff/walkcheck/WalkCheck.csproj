<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compares every concrete SqlPart class's WalkCode with what the original tables and
    `is` lists give. Needs a tree with patch 01 applied:
      dotnet run -c Release -p:SaPath=/path/to/patched/src/SqlArtisan/SqlArtisan.csproj
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SaPath)" />
  </ItemGroup>

</Project>
