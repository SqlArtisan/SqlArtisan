+            }
+
+            i = (i + 1) & _slotMask;
+        }
+    }
+
+    private void PlaceSlot(BindValue bindValue, int index)
+    {
+        int[] slots = _slots!;
+        int i = RuntimeHelpers.GetHashCode(bindValue) & _slotMask;
+        while (slots[i] != 0)
+        {
+            i = (i + 1) & _slotMask;
+        }
+
+        slots[i] = index + 1;
+    }
+
+    private void InsertSlot(BindValue bindValue, int index)
+    {
