+    // The parameter list once a scan for an instance costs more than a hash probe. A subclass,
+    // so the buffer needs no field for the index: one would cost every build 8 bytes (ADR 0006).
+    private sealed class IndexedParameterList : List<KeyValuePair<string, BindValue>>
+    {
+        // Measured on .NET 10: the scan and the probe meet near 100 parameters.
+        internal const int MinCount = 128;
+
+        // Hashing an instance for the first time is the index's cost. Two earlier entries per
+        // append spread it, so a statement that ends just past the switch never pays for all.
+        private const int PlacedPerAppend = 2;
+
+        // Open addressing by instance: a slot holds an entry's position plus one, 0 while
+        // empty. Rented, and at most half full, so a probe always meets an empty slot: an
+        // unindexed entry takes no slot, and Rebuild sizes the table for every entry.
+        private int[]? _slots;
+        private int _mask;
+        // The entries before this position have no slot yet and are found by scanning.
+        private int _awaitingSlot;
+
+        internal IndexedParameterList(
+            List<KeyValuePair<string, BindValue>>? source,
+            int capacity)
+            : base(capacity)
+        {
+            if (source is not null)
+            {
+                AddRange(source);
+            }
+
+            _awaitingSlot = Count;
+            RentSlots();
+        }
+
+        internal string? FindMarker(BindValue bindValue)
+        {
+            int[] slots = _slots!;
+            ReadOnlySpan<KeyValuePair<string, BindValue>> entries = CollectionsMarshal.AsSpan(this);
+            foreach (KeyValuePair<string, BindValue> entry in entries[.._awaitingSlot])
+            {
+                if (ReferenceEquals(entry.Value, bindValue))
+                {
+                    return entry.Key;
+                }
+            }
+
+            for (int i = RuntimeHelpers.GetHashCode(bindValue) & _mask; ; i = (i + 1) & _mask)
+            {
+                int ordinal = slots[i];
+                if (ordinal == 0)
+                {
+                    return null;
+                }
+
+                if (ReferenceEquals(entries[ordinal - 1].Value, bindValue))
+                {
+                    return entries[ordinal - 1].Key;
+                }
+            }
+        }
+
+        internal void AddIndexed(string name, BindValue bindValue)
+        {
+            Add(new(name, bindValue));
+            if (Count * 2 > _mask + 1)
+            {
+                Rebuild();
+            }
+            else
+            {
+                Place(Count - 1);
+                for (int n = Math.Min(PlacedPerAppend, _awaitingSlot); n > 0; n--)
+                {
+                    Place(--_awaitingSlot);
+                }
+            }
+        }
+
+        // The list outlives the build inside its SqlStatement; the rented index must not.
+        internal void ReleaseIndex()
+        {
+            if (_slots is not null)
+            {
+                ArrayPool<int>.Shared.Return(_slots);
+                _slots = null;
+            }
+        }
+
+        private void Rebuild()
+        {
+            ReleaseIndex();
+            RentSlots();
+            _awaitingSlot = 0;
+            for (int i = 0; i < Count; i++)
