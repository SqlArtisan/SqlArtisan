+            "SELECT \"t\".name FROM test_table \"t\" WHERE \"t\".code IN (:0, :0, :0, :0, :0)",
+            sql.Text);
+        Assert.Equal(1, sql.Parameters.Count);
+        Assert.Equal(8, KeptList(sql).Capacity);
+    }
+
+    // The reservation changes no capacity a statement keeps, only the arrays it drops on the
+    // way there, so it shows in bytes alone: held binds are not reserved for, and the same
+    // values passed directly are.
+    [Fact]
+    public void In_ValuesPassedDirectly_AllocatesLessThanTheSameValuesAsHeldBinds()
+    {
+        const int Builds = 16;
+        ISqlBuilder[] direct = new ISqlBuilder[Builds + 1];
+        ISqlBuilder[] held = new ISqlBuilder[Builds + 1];
+        for (int i = 0; i <= Builds; i++)
+        {
+            direct[i] = Select(_t.Name).From(_t).Where(
+                _t.Code.In(Enumerable.Range(0, 20).ToArray()));
+            held[i] = Select(_t.Name).From(_t).Where(
+                _t.Code.In([.. Enumerable.Range(0, 20).Select(v => (object)Bind(v))]));
+        }
+
+        // The first build of each pays for what the runtime allocates once.
+        Assert.Equal(direct[Builds].Build().Text, held[Builds].Build().Text);
+
+        long directBytes = AllocatedBy(direct.AsSpan(0, Builds));
+        long heldBytes = AllocatedBy(held.AsSpan(0, Builds));
+
+        // The 4-, 8- and 16-entry arrays a list of 20 doubles through: 88 + 152 + 280 bytes.
+        Assert.Equal(520 * Builds, heldBytes - directBytes);
+    }
+
+    private static List<KeyValuePair<string, BindValue>> KeptList(SqlStatement sql) =>
+        (List<KeyValuePair<string, BindValue>>)typeof(SqlParameters)
+            .GetField("_parameters", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .GetValue(sql.Parameters)!;
+
+    private static object? RentedIndex(object indexedList) =>
+        indexedList.GetType()
+            .GetField("_slots", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .GetValue(indexedList);
+
+    private static object? AwaitingSlot(object indexedList) =>
+        indexedList.GetType()
+            .GetField("_awaitingSlot", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .GetValue(indexedList);
+
+    private static int SlotCount(object indexedList) =>
+        (int)indexedList.GetType()
+            .GetField("_mask", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .GetValue(indexedList)! + 1;
+
+    private static long AllocatedBy(ReadOnlySpan<ISqlBuilder> builders)
+    {
+        long before = GC.GetAllocatedBytesForCurrentThread();
+        foreach (ISqlBuilder builder in builders)
+        {
+            builder.Build();
+        }
+
+        return GC.GetAllocatedBytesForCurrentThread() - before;
+    }
+
+    // Built per case rather than passed in: xUnit reads a theory argument's properties to
+    // name the case, and a builder's set-operator properties continue it.
+    private ISqlBuilder ReservedShape(string shape)
+    {
+        BindValue held = Bind(-1);
+        BindValue[] tenant = [.. Enumerable.Range(0, 4).Select(i => Bind($"tenant{i}"))];
+        SqlCondition twice = _t.Code.In(Enumerable.Range(0, 100).ToArray());
+        BindValue[] earlier = [.. Enumerable.Range(0, 300).Select(i => Bind(i))];
+        SqlCondition bound = _t.Code == earlier[0];
+        foreach (BindValue bind in earlier.AsSpan(1))
+        {
+            bound |= _t.Code == bind;
+        }
+
+        ISelectBuilderFrom select = Select(_t.Name).From(_t);
+        return shape switch
+        {
+            "distinct values" => select.Where(_t.Code.In(Enumerable.Range(0, 300).ToArray())),
+            "binds added one at a time" => select.Where(
+                Enumerable.Range(1, 199).Aggregate(
+                    (SqlCondition)(_t.Code != 0),
+                    (all, i) => all & _t.Code != i)),
+            "one held bind repeated" => select.Where(
+                _t.Code.In([.. Enumerable.Repeat((object)held, 500)])),
+            "a list formatted twice" => select.Where(twice | twice),
+            "binds bound before the list" => select.Where(bound & _t.Code.NotIn(earlier)),
+            "held binds in every row" => InsertInto(_t, _t.Code, _t.Name, _t.CreatedAt).Values(
+                [.. Enumerable.Range(0, 1000)
+                    .Select(i => new object?[] { i, tenant[i % 4], tenant[0] })]),
+            _ => throw new ArgumentOutOfRangeException(nameof(shape)),
+        };
+    }
+}
