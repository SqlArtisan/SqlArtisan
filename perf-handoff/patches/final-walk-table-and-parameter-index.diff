@@ -0,0 +1,9 @@
+namespace SqlArtisan.Internal;
+
+// The bind a resolver makes for a value passed where an expression goes: one instance per
+// occurrence, so each is a new parameter, which a BindValue the caller holds need not be.
+// SqlParameters.ForEach hands one to a caller, who can then repeat it.
+internal sealed class ImplicitBindValue(object directlyBindable)
+    : BindValue(directlyBindable, Checked.DirectlyBindable)
+{
+}
