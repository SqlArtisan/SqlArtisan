@@ -0,0 +1,466 @@
+using System.Data;
+using System.Numerics;
+using System.Reflection;
+using System.Text;
+using static SqlArtisan.Sql;
+
+namespace SqlArtisan.Tests;
+
+// From 128 parameters the buffer finds an instance it has already bound through a hash
+// index, which takes the earlier entries in two per append and grows at 257 and 1,025, and a
+// list of values reserves the parameter list; these statements cross those counts.
+public class ParameterListTests
+{
+    private readonly TestTable _t = new("t");
+
+    [Fact]
+    public void In_SharedBindPastTheIndexedCount_ReusesMarker()
+    {
+        BindValue shared = Bind(-1);
+        object[] values =
+            [.. Enumerable.Range(0, 300).Select(i => i % 50 == 0 ? shared : (object)i)];
+
+        SqlStatement sql =
+            Select(_t.Name)
+            .From(_t)
+            .Where(_t.Code.In(values))
+            .Build();
+
+        StringBuilder expected = new(
+            "SELECT \"t\".name FROM test_table \"t\" WHERE \"t\".code IN (:0");
+        for (int i = 1, next = 1; i < 300; i++)
+        {
+            expected.Append(i % 50 == 0 ? ", :0" : $", :{next++}");
+        }
+
+        expected.Append(')');
+
+        Assert.Equal(expected.ToString(), sql.Text);
+        Assert.Equal(295, sql.Parameters.Count);
+        Assert.Equal(-1, sql.Parameters.Get<int>(":0"));
+        Assert.Equal(299, sql.Parameters.Get<int>(":294"));
+    }
+
+    [Fact]
+    public void In_SharedBindFromBeforeTheList_ReusesMarker()
+    {
+        BindValue shared = Bind(-1);
+        object[] values =
+            [.. Enumerable.Range(0, 1100).Select(i => i == 1099 ? shared : (object)i)];
+
+        SqlStatement sql =
+            Select(_t.Name)
+            .From(_t)
+            .Where(_t.Code == shared | _t.Code.In(values))
+            .Build();
+
+        StringBuilder expected = new(
+            "SELECT \"t\".name FROM test_table \"t\" WHERE (\"t\".code = :0) OR (\"t\".code IN (");
+        for (int i = 1; i < 1100; i++)
+        {
+            expected.Append($":{i}, ");
+        }
+
+        expected.Append(":0))");
+
+        Assert.Equal(expected.ToString(), sql.Text);
+        Assert.Equal(1100, sql.Parameters.Count);
+        Assert.Equal(-1, sql.Parameters.Get<int>(":0"));
+        Assert.Equal(1098, sql.Parameters.Get<int>(":1099"));
+    }
+
+    [Fact]
+    public void Where_SharedBindAcrossAListGrownOneAtATime_ReusesMarker()
+    {
+        BindValue shared = Bind(-1);
+        SqlCondition condition = _t.Code == shared;
+        for (int i = 1; i <= 300; i++)
+        {
+            condition &= _t.Code != i;
+        }
+
+        condition &= _t.Code == shared;
+
+        SqlStatement sql =
+            Select(_t.Name)
+            .From(_t)
+            .Where(condition)
+            .Build();
+
+        StringBuilder expected = new(
+            "SELECT \"t\".name FROM test_table \"t\" WHERE (\"t\".code = :0)");
+        for (int i = 1; i <= 300; i++)
+        {
+            expected.Append($" AND (\"t\".code <> :{i})");
+        }
+
+        expected.Append(" AND (\"t\".code = :0)");
+
+        Assert.Equal(expected.ToString(), sql.Text);
+        Assert.Equal(301, sql.Parameters.Count);
+        Assert.Equal(300, sql.Parameters.Get<int>(":300"));
+    }
+
+    [Fact]
+    public void Values_SharedBindAcrossManyRows_ReusesMarker()
+    {
+        BindValue shared = Bind("same");
+        object?[][] rows = [.. Enumerable.Range(0, 100).Select(i => new object?[] { i, shared })];
+
+        SqlStatement sql =
+            InsertInto(_t, _t.Code, _t.Name)
+            .Values(rows)
+            .Build();
+
+        StringBuilder expected = new(
+            "INSERT INTO test_table AS \"t\" (code, name) VALUES (:0, :1)");
+        for (int i = 1; i < 100; i++)
+        {
+            expected.Append($", (:{i + 1}, :1)");
+        }
+
+        Assert.Equal(expected.ToString(), sql.Text);
+        Assert.Equal(101, sql.Parameters.Count);
+        Assert.Equal("same", sql.Parameters.Get<string>(":1"));
+        Assert.Equal(99, sql.Parameters.Get<int>(":100"));
+    }
+
+    // The index takes the 128 entries from before it two per append, last first, so a bind
+    // is found by the scan until its turn and by the probe after: both sides of each turn.
+    [Theory]
+    [InlineData(127, 129)]
+    [InlineData(127, 130)]
+    [InlineData(126, 129)]
+    [InlineData(126, 130)]
+    [InlineData(64, 160)]
+    [InlineData(64, 161)]
+    [InlineData(0, 129)]
+    [InlineData(0, 191)]
+    [InlineData(0, 192)]
+    [InlineData(0, 193)]
+    [InlineData(0, 256)]
+    [InlineData(0, 257)]
+    [InlineData(200, 256)]
+    [InlineData(200, 257)]
+    public void Where_SharedBindReusedWhileTheIndexFills_ReusesMarker(int position, int reuse)
+    {
+        BindValue shared = Bind(-1);
+        SqlCondition condition = position == 0 ? _t.Code == shared : _t.Code != 0;
+        for (int i = 1; i < reuse; i++)
+        {
+            condition &= i == position ? _t.Code == shared : _t.Code != i;
+        }
+
+        condition &= _t.Code == shared;
+
+        SqlStatement sql =
+            Select(_t.Name)
+            .From(_t)
+            .Where(condition)
+            .Build();
+
+        StringBuilder expected = new("SELECT \"t\".name FROM test_table \"t\" WHERE ");
+        expected.AppendJoin(
+            " AND ",
+            Enumerable.Range(0, reuse).Select(
+                i => $"(\"t\".code {(i == position ? "=" : "<>")} :{i})"));
+        expected.Append($" AND (\"t\".code = :{position})");
+
+        Assert.Equal(expected.ToString(), sql.Text);
+        Assert.Equal(reuse, sql.Parameters.Count);
+        Assert.Equal(-1, sql.Parameters.Get<int>($":{position}"));
+    }
+
+    // Neither the SQL nor the parameters show whether a list was indexed, so the list a
+    // statement keeps is read: indexed from the 129th parameter added one at a time, from the
+    // 128th where a list of values had to reserve it, and with its rented index handed back.
+    [Theory]
+    [InlineData("one at a time", 128, false)]
+    [InlineData("one at a time", 129, true)]
+    [InlineData("IN", 127, false)]
+    [InlineData("IN", 128, true)]
+    [InlineData("NOT IN", 127, false)]
+    [InlineData("NOT IN", 128, true)]
+    [InlineData("VALUES", 126, false)]
+    [InlineData("VALUES", 128, true)]
+    [InlineData("IN after 100 binds", 128, false)]
+    [InlineData("IN after 100 binds", 129, true)]
+    public void Build_ParametersReachingTheIndexedCount_KeepsAnIndexedListWithoutItsIndex(
+        string shape,
+        int count,
+        bool indexed)
+    {
+        int chained = shape == "IN after 100 binds" ? 100 : count;
+        SqlCondition chain = _t.Code != 0;
+        for (int i = 1; i < chained; i++)
+        {
+            chain &= _t.Code != i;
+        }
+
+        int[] values = [.. Enumerable.Range(0, count)];
+        ISelectBuilderFrom select = Select(_t.Name).From(_t);
+        ISqlBuilder builder = shape switch
+        {
+            "one at a time" => select.Where(chain),
+            "IN after 100 binds" => select.Where(chain & _t.Code.In(values[100..])),
+            "IN" => select.Where(_t.Code.In(values)),
+            "NOT IN" => select.Where(_t.Code.NotIn(values)),
+            "VALUES" => InsertInto(_t, _t.Code, _t.Name).Values(
+                [.. Enumerable.Range(0, count / 2).Select(i => new object?[] { i, $"n{i}" })]),
+            _ => throw new ArgumentOutOfRangeException(nameof(shape)),
+        };
+
+        List<KeyValuePair<string, BindValue>> kept = KeptList(builder.Build());
+
+        Assert.Equal(count, kept.Count);
+        Assert.Equal(indexed, kept.GetType() != typeof(List<KeyValuePair<string, BindValue>>));
+        if (indexed)
+        {
+            Assert.Null(RentedIndex(kept));
+        }
+    }
+
+    // Two per append, so the 128 entries from before the index all have a slot 64 appends
+    // later; until then each lookup still scans the ones that wait.
+    [Theory]
+    [InlineData(129, 126)]
+    [InlineData(191, 2)]
+    [InlineData(192, 0)]
+    [InlineData(200, 0)]
+    public void Build_ParametersPastTheIndexedCount_LeavesTwoFewerUnindexedPerAppend(
+        int count,
+        int expectedAwaiting)
+    {
+        SqlCondition chain = _t.Code != 0;
+        for (int i = 1; i < count; i++)
+        {
+            chain &= _t.Code != i;
+        }
+
+        List<KeyValuePair<string, BindValue>> kept =
+            KeptList(Select(_t.Name).From(_t).Where(chain).Build());
+
+        Assert.Equal(expectedAwaiting, AwaitingSlot(kept));
+    }
+
+    // An output parameter is never looked up again, so it takes no slot and no turn: after
+    // 130 binds and 10 outputs the index is as far along as after the binds alone.
+    [Fact]
+    public void Returning_Oracle_OutputParametersPastTheIndexedCount_TakeNoSlot()
+    {
+        DbColumn[] columns = [.. Enumerable.Range(0, 130).Select(i => new DbColumn(_t, $"c{i}"))];
+        OutputParameter[] outputs =
+            [.. Enumerable.Range(0, 10).Select(i => new OutputParameter($"v{i}", DbType.Int32))];
+
+        SqlStatement sql =
+            Update(_t)
+            .Set([.. columns.Select((c, i) => c == i)])
+            .Returning([.. columns.AsSpan(0, 10)])
+            .Into(outputs)
+            .Build(Dbms.Oracle);
+
+        Assert.Equal(140, sql.Parameters.Count);
+        Assert.Equal(124, AwaitingSlot(KeptList(sql)));
+    }
+
+    // A build that throws never reaches the statement, so the buffer's Dispose hands the
+    // index back; the buffer is internal and gone by then, so it is driven directly.
+    [Fact]
+    public void Dispose_IndexedList_HandsBackItsIndex()
+    {
+        Type type = typeof(SqlPart).Assembly.GetType("SqlArtisan.Internal.SqlBuildingBuffer")!;
+        IDisposable buffer = (IDisposable)Activator.CreateInstance(
+            type,
+            BindingFlags.NonPublic | BindingFlags.Instance,
+            binder: null,
+            [Dbms.PostgreSql],
+            culture: null)!;
+        MethodInfo addParameter = type.GetMethod(
+            "AddParameter",
+            BindingFlags.NonPublic | BindingFlags.Instance)!;
+        for (int i = 0; i < 129; i++)
+        {
+            addParameter.Invoke(buffer, [Bind(i)]);
+        }
+
+        object list = type
+            .GetField("_parameters", BindingFlags.NonPublic | BindingFlags.Instance)!
+            .GetValue(buffer)!;
+
+        Assert.NotNull(RentedIndex(list));
+
+        buffer.Dispose();
+
+        Assert.Null(RentedIndex(list));
+    }
+
+    // Output parameters take no slot in the index, so the table is sized for every entry
+    // when the binds a held stage appends after them make it grow.
+    [Fact]
+    public void Returning_Oracle_HeldStageBindsAfterManyOutputParameters_CorrectSql()
+    {
+        DbColumn[] columns = [.. Enumerable.Range(0, 130).Select(i => new DbColumn(_t, $"c{i}"))];
+        BindValue shared = Bind(0);
+        EqualityCondition[] assignments =
+            [.. columns.Select((c, i) => i == 0 ? c == shared : c == i)];
+        OutputParameter[] outputs =
+            [.. Enumerable.Range(0, 600).Select(i => new OutputParameter($"v{i}", DbType.Int32))];
+        object[] returned = [.. Enumerable.Range(0, 600).Select(i => (object)columns[i % 130])];
+
+        IUpdateBuilderSet held = Update(_t).Set(assignments);
+        held.Returning(returned).Into(outputs);
+
+        SqlStatement sql = held.Where(_t.Code == shared & _t.Name == "n").Build(Dbms.Oracle);
+
+        StringBuilder expected = new("UPDATE test_table \"t\" SET ");
+        expected.AppendJoin(", ", Enumerable.Range(0, 130).Select(i => $"c{i} = :{i}"));
+        expected.Append(" RETURNING ");
+        expected.AppendJoin(", ", Enumerable.Range(0, 600).Select(i => $"\"t\".c{i % 130}"));
+        expected.Append(" INTO ");
+        expected.AppendJoin(", ", Enumerable.Range(0, 600).Select(i => $":v{i}"));
+        expected.Append(" WHERE (\"t\".code = :0) AND (\"t\".name = :730)");
+
+        Assert.Equal(expected.ToString(), sql.Text);
+        Assert.Equal(731, sql.Parameters.Count);
+        Assert.Equal(0, sql.Parameters.Get<int>(":0"));
+        Assert.Equal("n", sql.Parameters.Get<string>(":730"));
+        Assert.Equal(0, AwaitingSlot(KeptList(sql)));
+        Assert.Equal(4096, SlotCount(KeptList(sql)));
+    }
+
+    // A reservation is for parameters that will arrive: a held bind that repeats, a list
+    // formatted a second time and a bind bound earlier add none, so the list a statement
+    // keeps is as large as its own doubling would have made it, as is one grown unreserved.
+    [Theory]
+    [InlineData("distinct values", 300)]
+    [InlineData("binds added one at a time", 200)]
+    [InlineData("one held bind repeated", 1)]
+    [InlineData("a list formatted twice", 100)]
+    [InlineData("binds bound before the list", 300)]
+    [InlineData("held binds in every row", 1004)]
+    public void Build_ListOfValues_KeepsNoMoreCapacityThanDoublingWould(
+        string shape,
+        int expectedCount)
+    {
+        List<KeyValuePair<string, BindValue>> kept = KeptList(ReservedShape(shape).Build());
+
+        Assert.Equal(expectedCount, kept.Count);
+        Assert.Equal(
+            Math.Max(4, (int)BitOperations.RoundUpToPowerOf2((uint)kept.Count)),
+            kept.Capacity);
+    }
+
+    // The one repeat a reservation cannot tell: an implicit bind is new wherever a value is
+    // passed, but SqlParameters.ForEach hands the instance out, and a caller who repeats it
+    // in one list has every occurrence reserved for. The SQL and the parameter are the same.
+    [Fact]
+    public void In_ImplicitBindReadBackAndRepeated_ReservesForEveryOccurrence()
+    {
+        BindValue readBack = null!;
+        Select(_t.Name).From(_t).Where(_t.Code == 1).Build().Parameters.ForEach(
+            (_, bind) => readBack = bind);
+
+        SqlStatement sql =
+            Select(_t.Name)
+            .From(_t)
+            .Where(_t.Code.In([.. Enumerable.Repeat((object)readBack, 5)]))
+            .Build();
+
