<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway timing/allocation harness for the build path (see ../README.md).
    Not in SqlArtisan.sln. Point SaPath at another checkout to measure a variant:
      dotnet build -c Release -o out/variant -p:SaPath=/path/to/tree/src/SqlArtisan/SqlArtisan.csproj
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>H</AssemblyName>
    <SaPath Condition="'$(SaPath)' == ''">$(MSBuildThisFileDirectory)../../src/SqlArtisan/SqlArtisan.csproj</SaPath>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SaPath)" />
  </ItemGroup>

</Project>
